{
  "name": "dashcenter",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "A GUI-managed, self-hosted dashboard for Docker and Portainer.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"DEV_BYPASS_AUTH=1 tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "DEV_BYPASS_AUTH=1 tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.build.json",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "licenses:check": "node scripts/generate-license-inventory.mjs --check",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "packageManager": "pnpm@11.19.0"
}
