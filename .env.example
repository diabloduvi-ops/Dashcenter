# Host port used to open Dashcenter.
DASHCENTER_PORT=3000

# Container timezone, for example Europe/Bratislava.
TZ=UTC

# HTTPS reverse proxy: true / true
# Trusted LAN or VPN over plain HTTP: false / false
TRUST_PROXY=false
SESSION_COOKIE_SECURE=true

# Optional source commit recorded in the built image and health endpoint.
# CI and release builds set this automatically; local builds may leave it unknown.
DASHCENTER_REVISION=unknown
